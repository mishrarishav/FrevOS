# This sidecar joins the existing local preview network; it owns no app data.
FREVOS_WAF_IMAGE=ghcr.io/coreruleset/coraza-crs@sha256:8873f6a5042dad27dde7cfc07f6a47d3871cac01f719324d4c24bdabc4a0e07a
FREVOS_WAF_NETWORK=frevos-local_default
FREVOS_WAF_BIND=127.0.0.1
FREVOS_WAF_PORT=8380
FREVOS_WAF_UPSTREAM=http://frevos:10000
FREVOS_WAF_BASE_PATH=
# Review normal application traffic before changing DetectionOnly to On.
FREVOS_WAF_MODE=DetectionOnly
FREVOS_WAF_PARANOIA=1
FREVOS_WAF_INBOUND_SCORE=5
FREVOS_WAF_BODY_LIMIT=67108864
FREVOS_WAF_NOFILES_LIMIT=33554432
FREVOS_WAF_TRANSPORT_LIMIT=536870912
# Only the immediate configured gateway may supply forwarding headers.
FREVOS_WAF_TRUSTED_PROXIES=127.0.0.1/32 ::1/128
